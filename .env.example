# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored — never commit real credentials.

# Google Earth Engine cloud project ID (from https://code.earthengine.google.com/)
GEE_PROJECT_ID=your-gee-project-id-here

# Optional: default export folder on Google Drive
GEE_DRIVE_FOLDER=flood-recovery-exports

# Optional: local scratch dir for downloaded exports
LOCAL_EXPORT_DIR=./data/raw
